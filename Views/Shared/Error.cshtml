@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex align-items-start gap-3">
            <span class="feature-icon bg-danger-subtle text-danger"><i class="bi bi-exclamation-triangle"></i></span>
            <div>
                <h1 class="h3 text-danger mb-2">حدث خطأ</h1>
                <p class="text-muted mb-3">تعذّر معالجة طلبك. حاول مرة أخرى لاحقاً.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="mb-3">
                        <strong>معرّف الطلب:</strong>
                        <code class="ltr">@Model.RequestId</code>
                    </p>
                }

                <div class="alert alert-warning mb-0">
                    <h2 class="h6">وضع التطوير</h2>
                    <p class="mb-0 small">
                        تفعيل بيئة <strong>Development</strong> يعرض تفاصيل أكثر عن الخطأ.
                        لا تفعّلها على بيئات الإنتاج لأنها قد تكشف معلومات حسّاسة.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
