@model ScraperUrl

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">الاسم</label>
        <input asp-for="Name" class="form-control arabic-text" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Domain" class="form-label">النطاق</label>
        <input asp-for="Domain" class="form-control ltr" placeholder="eg" />
        <span asp-validation-for="Domain" class="text-danger"></span>
        <div class="form-text">يُستنتج من الرابط إن تُرك فارغاً عند الحفظ.</div>
    </div>
    <div class="col-md-3">
        <label asp-for="StartPage" class="form-label">صفحة البداية</label>
        <input asp-for="StartPage" class="form-control ltr" type="number" min="1" />
        <span asp-validation-for="StartPage" class="text-danger"></span>
    </div>
</div>

<div class="mt-3">
    <label asp-for="Url" class="form-label">رابط صفحة البحث</label>
    <textarea asp-for="Url" class="form-control ltr" rows="4" placeholder="https://www.amazon.eg/-/en/s?k=..."></textarea>
    <span asp-validation-for="Url" class="text-danger"></span>
    <div class="form-text">الصق رابط نتائج البحث كاملاً (الفلاتر والترتيب داخل الرابط). يُضاف/يُحدَّث باراميتر <code class="ltr">page</code> تلقائياً.</div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-3">
        <label asp-for="IntervalSeconds" class="form-label">الفاصل (ثانية)</label>
        <input asp-for="IntervalSeconds" class="form-control ltr" type="number" min="60" />
        <span asp-validation-for="IntervalSeconds" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DropAlertPercent" class="form-label">حد التنبيه %</label>
        <input asp-for="DropAlertPercent" class="form-control ltr" type="number" min="1" max="100" step="0.1" />
        <span asp-validation-for="DropAlertPercent" class="text-danger"></span>
        <div class="form-text">انخفاض من السعر السابق، وأقل من المتوسط بنفس النسبة (تحت 10%).</div>
    </div>
    <div class="col-md-3">
        <label asp-for="AsinRecheckIntervalMinutes" class="form-label">فاصل فحص ASIN (دقيقة)</label>
        <input asp-for="AsinRecheckIntervalMinutes" class="form-control ltr" type="number" min="0" max="10080" />
        <span asp-validation-for="AsinRecheckIntervalMinutes" class="text-danger"></span>
        <div class="form-text">أقل فاصل بين إعادة فحص منتجات هذا الرابط. 0 = بدون حد (الافتراضي).</div>
    </div>
    <div class="col-md-3">
        <label asp-for="LongUnavailableRecheckIntervalMinutes" class="form-label">فاصل غير المتوفر (دقيقة)</label>
        <input asp-for="LongUnavailableRecheckIntervalMinutes" class="form-control ltr" type="number" min="1" max="10080" />
        <span asp-validation-for="LongUnavailableRecheckIntervalMinutes" class="text-danger"></span>
        <div class="form-text">بعد 24 ساعة عدم توفر: أقل فاصل بين إعادة فحص ASIN (افتراضي 180).</div>
    </div>
    <div class="col-md-3">
        <label asp-for="Category" class="form-label">التصنيف</label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<ScraperCategory>()" class="form-select arabic-text">
            <option value="">بدون تصنيف</option>
        </select>
        <span asp-validation-for="Category" class="text-danger"></span>
        <div class="form-text">يحدد مجموعة تيليجرام. بدون تصنيف لا تُرسل تنبيهات.</div>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="IsEnabled" class="form-check-input" />
            <label asp-for="IsEnabled" class="form-check-label">مفعّل</label>
        </div>
        <div class="form-check mb-2 ms-3">
            <input asp-for="IsAsinRecheckEnabled" class="form-check-input" />
            <label asp-for="IsAsinRecheckEnabled" class="form-check-label">إعادة فحص ASIN</label>
        </div>
    </div>
</div>
