@model IEnumerable<ScraperUrl>
@{
    ViewData["Title"] = "روابط السكرابر";
    var search = ViewData["Search"] as string;
    var hasCategory = ViewData["HasCategory"] as bool?;
    var isEnabled = ViewData["IsEnabled"] as bool?;
    var isAsinRecheckEnabled = ViewData["IsAsinRecheckEnabled"] as bool?;
    var sort = ViewData["Sort"] as string;
    var allNames = ViewData["AllNames"] as List<string> ?? [];
    var isFiltered = !string.IsNullOrWhiteSpace(search) || hasCategory.HasValue || isEnabled.HasValue || isAsinRecheckEnabled.HasValue;
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">روابط السكرابر</h1>
        <p class="text-muted mb-0">
            تُجلب صفحات أمازون عبر ISP proxy، ثم تُحلَّل المنتجات من HTML. يُنفَّذ كل رابط مفعّل حسب فاصله الزمني.
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> إضافة رابط</a>
    </div>
</div>

<form asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3">
    <input type="search" name="search" value="@search" list="scraperNames" class="form-control w-auto arabic-text"
           placeholder="بحث بالاسم..." aria-label="بحث بالاسم" autocomplete="off" onchange="this.form.submit()" />
    <datalist id="scraperNames">
        @foreach (var name in allNames)
        {
            <option value="@name"></option>
        }
    </datalist>
    <select name="hasCategory" class="form-select w-auto arabic-text" aria-label="تصفية حسب التصنيف" onchange="this.form.submit()">
        <option value="" selected="@(hasCategory is null)">كل التصنيفات</option>
        <option value="true" selected="@(hasCategory == true)">لها تصنيف</option>
        <option value="false" selected="@(hasCategory == false)">بدون تصنيف</option>
    </select>
    <select name="isEnabled" class="form-select w-auto arabic-text" aria-label="تصفية حسب التفعيل" onchange="this.form.submit()">
        <option value="" selected="@(isEnabled is null)">كل الحالات</option>
        <option value="true" selected="@(isEnabled == true)">مفعّل</option>
        <option value="false" selected="@(isEnabled == false)">معطّل</option>
    </select>
    <select name="isAsinRecheckEnabled" class="form-select w-auto arabic-text" aria-label="تصفية حسب فحص ASIN" onchange="this.form.submit()">
        <option value="" selected="@(isAsinRecheckEnabled is null)">فحص ASIN: الكل</option>
        <option value="true" selected="@(isAsinRecheckEnabled == true)">فحص ASIN مفعّل</option>
        <option value="false" selected="@(isAsinRecheckEnabled == false)">فحص ASIN معطّل</option>
    </select>
    <select name="sort" class="form-select w-auto arabic-text" aria-label="الترتيب" onchange="this.form.submit()">
        <option value="" selected="@(string.IsNullOrEmpty(sort))">الاسم (أ-ي)</option>
        <option value="name_desc" selected="@(sort == "name_desc")">الاسم (ي-أ)</option>
        <option value="lastRun" selected="@(sort == "lastRun")">آخر تشغيل</option>
        <option value="interval" selected="@(sort == "interval")">الفاصل</option>
        <option value="created" selected="@(sort == "created")">الأحدث إضافة</option>
    </select>
    @if (isFiltered)
    {
        <a asp-action="Index" asp-route-sort="@sort" class="btn btn-outline-secondary">مسح التصفية</a>
    }
</form>

@if (TempData["StatusMessage"] is string message)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

@Html.AntiForgeryToken()

@if (Model.Any())
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="text-muted small" id="bulkSelectedCount">لم يتم تحديد روابط</span>
        <button type="button" class="btn btn-sm btn-success" id="bulkEnable" disabled>
            <i class="bi bi-toggle-on"></i> تفعيل
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="bulkDisable" disabled>
            <i class="bi bi-toggle-off"></i> تعطيل
        </button>
        <button type="button" class="btn btn-sm btn-outline-success" id="bulkEnableRecheck" disabled>
            <i class="bi bi-arrow-repeat"></i> تفعيل فحص ASIN
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="bulkDisableRecheck" disabled>
            <i class="bi bi-slash-circle"></i> تعطيل فحص ASIN
        </button>
        <select class="form-select form-select-sm w-auto arabic-text" id="bulkCategory" disabled aria-label="تعيين التصنيف">
            <option value="">بدون تصنيف</option>
            @foreach (var option in Html.GetEnumSelectList<ScraperCategory>())
            {
                <option value="@option.Value">@option.Text</option>
            }
        </select>
        <button type="button" class="btn btn-sm btn-outline-primary" id="bulkAssignCategory" disabled>
            <i class="bi bi-tag"></i> تعيين التصنيف
        </button>
    </div>
}

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="searchesTable">
            <thead>
                <tr>
                    <th style="width:40px">
                        @if (Model.Any())
                        {
                            <input type="checkbox" class="form-check-input" id="selectAllSearches" title="تحديد الكل" aria-label="تحديد الكل" />
                        }
                    </th>
                    <th>الاسم</th>
                    <th>التصنيف</th>
                    <th>النطاق</th>
                    <th>الفاصل</th>
                    <th>مفعّل</th>
                    <th>فحص ASIN</th>
                    <th>آخر تشغيل (UTC)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr class="search-row @(item.IsEnabled ? "" : "table-secondary")" data-search-id="@item.Id">
                    <td>
                        <input type="checkbox" class="form-check-input search-select" value="@item.Id" aria-label="تحديد @item.Name" />
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="fw-semibold arabic-text">@item.Name</a>
                    </td>
                    <td>
                        @if (item.Category is { } category)
                        {
                            <span class="badge text-bg-light arabic-text">@category.DisplayName()</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning">بدون تصنيف</span>
                        }
                    </td>
                    <td class="ltr">@item.Domain</td>
                    <td class="num">@item.IntervalSeconds ث</td>
                    <td class="search-enabled">
                        @if (item.IsEnabled)
                        {
                            <span class="badge text-bg-success"><span class="status-dot on"></span> نعم</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary"><span class="status-dot off"></span> لا</span>
                        }
                    </td>
                    <td>
                        @if (item.IsAsinRecheckEnabled)
                        {
                            <span class="badge text-bg-success"><span class="status-dot on"></span> نعم</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary"><span class="status-dot off"></span> لا</span>
                        }
                    </td>
                    <td>
                        @if (item.LastRunAt.HasValue)
                        {
                            <span class="num">@item.LastRunAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                            @if (!string.IsNullOrEmpty(item.LastRunError))
                            {
                                <div class="small text-danger text-truncate" style="max-width:12rem" title="@item.LastRunError">@item.LastRunError</div>
                            }
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">تعديل</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any() && isFiltered)
{
    <div class="empty-state mt-3">
        <p class="mb-2">لا توجد روابط مطابقة للتصفية.</p>
        <a asp-action="Index" class="btn btn-outline-secondary">عرض كل الروابط</a>
    </div>
}
else if (!Model.Any())
{
    <div class="empty-state mt-3">
        <p class="mb-2">لا توجد روابط بعد.</p>
        <a asp-action="Create" class="btn btn-primary">إضافة أول رابط</a>
    </div>
}

@section Scripts {
<script>
(() => {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    const selectAll = document.getElementById('selectAllSearches');
    const boxes = () => [...document.querySelectorAll('.search-select')];
    const countEl = document.getElementById('bulkSelectedCount');
    const enableBtn = document.getElementById('bulkEnable');
    const disableBtn = document.getElementById('bulkDisable');
    const enableRecheckBtn = document.getElementById('bulkEnableRecheck');
    const disableRecheckBtn = document.getElementById('bulkDisableRecheck');
    const categorySelect = document.getElementById('bulkCategory');
    const categoryBtn = document.getElementById('bulkAssignCategory');

    function selectedIds() {
        return boxes().filter(b => b.checked).map(b => Number(b.value));
    }

    function refresh() {
        const ids = selectedIds();
        const n = ids.length;
        if (countEl) countEl.textContent = n === 0 ? 'لم يتم تحديد روابط' : `تم تحديد ${n}`;
        if (enableBtn) enableBtn.disabled = n === 0;
        if (disableBtn) disableBtn.disabled = n === 0;
        if (enableRecheckBtn) enableRecheckBtn.disabled = n === 0;
        if (disableRecheckBtn) disableRecheckBtn.disabled = n === 0;
        if (categorySelect) categorySelect.disabled = n === 0;
        if (categoryBtn) categoryBtn.disabled = n === 0;
        if (selectAll) {
            const all = boxes();
            selectAll.checked = all.length > 0 && all.every(b => b.checked);
            selectAll.indeterminate = n > 0 && n < all.length;
        }
    }

    selectAll?.addEventListener('change', () => {
        boxes().forEach(b => { b.checked = selectAll.checked; });
        refresh();
    });
    document.getElementById('searchesTable')?.addEventListener('change', e => {
        if (e.target.classList.contains('search-select')) refresh();
    });

    async function bulk(url, payload) {
        const ids = selectedIds();
        if (!ids.length || !token) return;
        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token
            },
            body: JSON.stringify({ ids, ...payload })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.success) {
            alert(data.message || 'فشل التحديث');
            return;
        }
        location.reload();
    }

    const enabledUrl = '@Url.Action("BulkUpdateEnabled")';
    enableBtn?.addEventListener('click', () => bulk(enabledUrl, { isEnabled: true }));
    disableBtn?.addEventListener('click', () => bulk(enabledUrl, { isEnabled: false }));
    const recheckUrl = '@Url.Action("BulkUpdateAsinRecheck")';
    enableRecheckBtn?.addEventListener('click', () => bulk(recheckUrl, { isAsinRecheckEnabled: true }));
    disableRecheckBtn?.addEventListener('click', () => bulk(recheckUrl, { isAsinRecheckEnabled: false }));
    categoryBtn?.addEventListener('click', () => bulk('@Url.Action("BulkAssignCategory")', {
        category: categorySelect.value === '' ? null : Number(categorySelect.value)
    }));
    refresh();
})();
</script>
}
