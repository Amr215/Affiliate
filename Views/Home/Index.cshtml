@{
    ViewData["Title"] = "الرئيسية";
}

<section class="page-hero text-center">
    <h1 class="display-5 display-title">Affiliate</h1>
    <p class="lead mb-4">متابعة أسعار أمازون وتنبيهات الخصم عبر السكرابر والتيليجرام.</p>
    <div class="home-actions">
        <a asp-controller="Products" asp-action="Index" class="btn btn-light btn-lg">
            <i class="bi bi-box-seam"></i> عرض المنتجات
        </a>
        <a asp-controller="ScraperUrls" asp-action="Index" class="btn btn-outline-light btn-lg">
            <i class="bi bi-search"></i> روابط السكرابر
        </a>
    </div>
</section>

<div class="row g-3 feature-grid">
    <div class="col-md-4">
        <div class="card feature-card h-100">
            <div class="card-body">
                <div class="feature-icon"><i class="bi bi-search"></i></div>
                <h2 class="h5">روابط السكرابر</h2>
                <p class="text-muted mb-3">جلب صفحات أمازون عبر ISP proxy ثم تحليل المنتجات وحفظها تلقائياً.</p>
                <a asp-controller="ScraperUrls" asp-action="Index" class="btn btn-sm btn-outline-primary">إدارة الروابط</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-card h-100">
            <div class="card-body">
                <div class="feature-icon"><i class="bi bi-graph-up"></i></div>
                <h2 class="h5">تتبع الأسعار</h2>
                <p class="text-muted mb-3">مراقبة تغيّر الأسعار وتاريخ الخصومات للمنتجات المحفوظة.</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-outline-primary">عرض المنتجات</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card feature-card h-100">
            <div class="card-body">
                <div class="feature-icon"><i class="bi bi-telegram"></i></div>
                <h2 class="h5">تنبيهات تيليجرام</h2>
                <p class="text-muted mb-3">إرسال إشعارات عند انخفاض السعر بنسبة محددة.</p>
                <a asp-controller="Telegram" asp-action="Index" class="btn btn-sm btn-outline-primary">إعدادات تيليجرام</a>
            </div>
        </div>
    </div>
</div>
