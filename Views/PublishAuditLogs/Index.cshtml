@model PublishAuditLogsIndexViewModel
@using Affiliate.Models
@{
    ViewData["Title"] = "سجلات النشر";
    var f = Model.Filter;
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">سجلات النشر</h1>
        <p class="text-muted mb-0 d-flex flex-wrap gap-2">
            <span class="stat-pill"><i class="bi bi-journal-text"></i> @Model.TotalCount سجل</span>
            <span class="stat-pill" title="محاولات فاشلة ضمن المعروض">
                <i class="bi bi-x-circle text-danger"></i> @Model.FailedOnPageCount فشل ضمن المعروض
            </span>
            <span class="stat-pill" title="سقوط مسار السلة ضمن المعروض">
                <i class="bi bi-cart-x text-warning"></i> @Model.CartFallbackOnPageCount سقوط سلة
            </span>
        </p>
    </div>
</div>

<form method="get" asp-action="Index" class="card filter-card mb-4">
    <div class="card-header"><i class="bi bi-funnel"></i> عوامل التصفية</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-6 col-lg-2">
                <label class="form-label">ASIN</label>
                <input name="Asin" value="@f.Asin" class="form-control ltr" placeholder="B0…" maxlength="16" />
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">الحدث</label>
                <select name="EventType" class="form-select">
                    <option value="">الكل</option>
                    @foreach (PublishAuditEvent ev in Enum.GetValues<PublishAuditEvent>())
                    {
                        if (f.EventType == ev)
                        {
                            <option value="@((int)ev)" selected>@EventLabel(ev)</option>
                        }
                        else
                        {
                            <option value="@((int)ev)">@EventLabel(ev)</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">المسار</label>
                <select name="Route" class="form-select">
                    @{
                        var routes = new (string Value, string Text)[]
                        {
                            ("", "الكل"),
                            ("direct", "مباشر"),
                            ("proxy", "بروكسي")
                        };
                    }
                    @foreach (var option in routes)
                    {
                        if ((f.Route ?? "") == option.Value)
                        {
                            <option value="@option.Value" selected>@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">الصفحة</label>
                <select name="PageKind" class="form-select">
                    @{
                        var pages = new (string Value, string Text)[]
                        {
                            ("", "الكل"),
                            ("Dp", "منتج"),
                            ("Cart", "سلة")
                        };
                    }
                    @foreach (var option in pages)
                    {
                        if ((f.PageKind ?? "") == option.Value)
                        {
                            <option value="@option.Value" selected>@option.Text</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-lg-2">
                <label class="form-label">الفشل فقط</label>
                <select name="FailuresOnly" class="form-select">
                    <option value="">الكل</option>
                    @if (f.FailuresOnly == true)
                    {
                        <option value="true" selected>نعم</option>
                    }
                    else
                    {
                        <option value="true">نعم</option>
                    }
                </select>
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label">من تاريخ</label>
                <input name="From" value="@(f.From?.ToString("yyyy-MM-dd"))" class="form-control" type="date" />
            </div>
            <div class="col-sm-6 col-lg-2">
                <label class="form-label">إلى تاريخ</label>
                <input name="To" value="@(f.To?.ToString("yyyy-MM-dd"))" class="form-control" type="date" />
            </div>
            <div class="col-sm-6 col-lg-3">
                <label class="form-label">Correlation</label>
                <input name="CorrelationId" value="@f.CorrelationId" class="form-control ltr" placeholder="GUID" />
            </div>
            <div class="col-6 col-lg-1">
                <label class="form-label">حجم</label>
                <select name="PageSize" class="form-select">
                    @foreach (var size in new[] { 25, 50, 100, 200 })
                    {
                        if (f.PageSize == size)
                        {
                            <option value="@size" selected>@size</option>
                        }
                        else
                        {
                            <option value="@size">@size</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="mt-3 d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> تطبيق</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إعادة تعيين</a>
        </div>
    </div>
</form>

@if (Model.SessionSummary is { } session)
{
    <div class="card border-primary mb-4">
        <div class="card-header bg-primary-subtle">
            <i class="bi bi-info-circle"></i>
            ملخص الجلسة
            <span class="ltr small text-muted ms-2">@session.Asin</span>
            @if (!string.IsNullOrWhiteSpace(session.ProductName))
            {
                <span class="arabic-text small">— @session.ProductName</span>
            }
        </div>
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="stat-pill"><i class="bi bi-clock"></i> ~@session.WallClockSeconds ثانية إجمالي</span>
                <span class="stat-pill"><i class="bi bi-arrow-repeat"></i> @session.AttemptCount محاولة (@session.FailedAttemptCount فشل)</span>
                @if (session.PrepareSucceeded)
                {
                    <span class="stat-pill text-success"><i class="bi bi-check-circle"></i> تجهيز ناجح</span>
                }
                else
                {
                    <span class="stat-pill text-danger"><i class="bi bi-x-circle"></i> تجهيز فاشل</span>
                }
                @if (session.CartFellBack)
                {
                    <span class="stat-pill text-warning"><i class="bi bi-cart-x"></i> سقوط سلة</span>
                }
            </div>
            <ul class="mb-0 pe-3">
                @foreach (var line in session.Lines)
                {
                    <li class="mb-1">@line</li>
                }
            </ul>
        </div>
    </div>
}

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>الوقت (UTC)</th>
                    <th>المنتج</th>
                    <th>الحدث</th>
                    <th>المسار</th>
                    <th>الصفحة</th>
                    <th>النتيجة</th>
                    <th>مدة الحدث</th>
                    <th>مدة النشر الكاملة</th>
                    <th>التفاصيل</th>
                    <th>الجلسة</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var log in Model.Logs)
            {
                var rowClass = log.Success == false ? "table-danger"
                    : log.EventType == PublishAuditEvent.CartFallback ? "table-warning"
                    : "";
                <tr class="@rowClass">
                    <td class="num">@log.Id</td>
                    <td class="text-nowrap num">@log.OccurredAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        <div class="d-flex gap-2 align-items-center">
                            @if (!string.IsNullOrEmpty(log.ImageUrl))
                            {
                                <img src="@log.ImageUrl" alt="" class="product-thumb rounded border bg-white" width="48" height="48" loading="lazy" style="object-fit:contain" />
                            }
                            else
                            {
                                <div class="rounded border bg-light flex-shrink-0" style="width:48px;height:48px"></div>
                            }
                            <div class="min-w-0">
                                @if (log.ProductId is int productId)
                                {
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@productId"
                                       class="arabic-text d-block text-truncate" style="max-width: 260px" title="@log.ProductName">
                                        @(string.IsNullOrWhiteSpace(log.ProductName) ? log.Asin : log.ProductName)
                                    </a>
                                }
                                else
                                {
                                    <span class="arabic-text d-block text-truncate" style="max-width: 260px">
                                        @(string.IsNullOrWhiteSpace(log.ProductName) ? "—" : log.ProductName)
                                    </span>
                                }
                                <a asp-action="Index" asp-route-Asin="@log.Asin" class="ltr small text-muted">@log.Asin</a>
                            </div>
                        </div>
                    </td>
                    <td>
                        <span class="badge @EventBadge(log.EventType)">@EventLabel(log.EventType)</span>
                    </td>
                    <td class="ltr num">@(log.Route ?? "—")</td>
                    <td>
                        @if (log.PageKind == "Cart")
                        {
                            <span class="badge text-bg-info">سلة</span>
                        }
                        else if (log.PageKind == "Dp")
                        {
                            <span class="badge text-bg-secondary">منتج</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (log.Success == true)
                        {
                            <span class="badge text-bg-success">نجاح</span>
                        }
                        else if (log.Success == false)
                        {
                            <span class="badge text-bg-danger">فشل</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="num text-nowrap">
                        @if (log.EventType == PublishAuditEvent.Attempt && log.DurationMs is int ms)
                        {
                            <span title="@ms ms — مدة هذه المحاولة فقط">@(ms >= 1000 ? $"{ms / 1000.0:0.#} ث" : $"{ms} ms")</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="num text-nowrap">
                        @if (log.SessionDurationMs is int sessionMs)
                        {
                            <span title="@sessionMs ms — من أول حدث لآخر حدث في نفس الجلسة">
                                @(sessionMs >= 1000 ? $"{sessionMs / 1000.0:0.#} ث" : $"{sessionMs} ms")
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="small arabic-text" style="max-width: 420px; white-space: normal;">@log.ReadableDetail</td>
                    <td>
                        <a asp-action="Index"
                           asp-route-CorrelationId="@log.CorrelationId"
                           class="btn btn-sm btn-outline-primary ltr"
                           title="@log.CorrelationId">
                            جلسة
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Logs.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-journal-x"></i>
        <p class="mb-0">لا توجد سجلات مطابقة.</p>
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-3 d-flex justify-content-center" aria-label="صفحات سجلات النشر">
        <ul class="pagination mb-0">
            @{
                var prevDisabled = f.Page <= 1 ? "disabled" : null;
                var nextDisabled = f.Page >= Model.TotalPages ? "disabled" : null;
            }
            <li class="page-item @prevDisabled">
                <a class="page-link" asp-action="Index" asp-all-route-data="@(ToRoute(f, f.Page - 1))">السابق</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">صفحة @f.Page من @Model.TotalPages</span>
            </li>
            <li class="page-item @nextDisabled">
                <a class="page-link" asp-action="Index" asp-all-route-data="@(ToRoute(f, f.Page + 1))">التالي</a>
            </li>
        </ul>
    </nav>
}

@functions {
    private static string EventLabel(PublishAuditEvent ev) => ev switch
    {
        PublishAuditEvent.Requested => "طلب",
        PublishAuditEvent.Attempt => "محاولة",
        PublishAuditEvent.CartFallback => "سقوط سلة",
        PublishAuditEvent.Finished => "انتهى",
        PublishAuditEvent.PreviewSent => "معاينة",
        PublishAuditEvent.Confirmed => "تأكيد",
        PublishAuditEvent.Cancelled => "إلغاء",
        PublishAuditEvent.Failed => "فشل كلي",
        _ => ev.ToString()
    };

    private static string EventBadge(PublishAuditEvent ev) => ev switch
    {
        PublishAuditEvent.Requested => "text-bg-primary",
        PublishAuditEvent.Attempt => "text-bg-secondary",
        PublishAuditEvent.CartFallback => "text-bg-warning",
        PublishAuditEvent.Finished => "text-bg-success",
        PublishAuditEvent.PreviewSent => "text-bg-info",
        PublishAuditEvent.Confirmed => "text-bg-success",
        PublishAuditEvent.Cancelled => "text-bg-dark",
        PublishAuditEvent.Failed => "text-bg-danger",
        _ => "text-bg-light"
    };

    private static Dictionary<string, string?> ToRoute(PublishAuditLogFilterViewModel filter, int page)
    {
        var d = new Dictionary<string, string?>
        {
            ["Page"] = page.ToString(),
            ["PageSize"] = filter.PageSize.ToString(),
            ["Asin"] = filter.Asin,
            ["EventType"] = filter.EventType.HasValue ? ((int)filter.EventType.Value).ToString() : null,
            ["Route"] = filter.Route,
            ["PageKind"] = filter.PageKind,
            ["FailuresOnly"] = filter.FailuresOnly == true ? "true" : null,
            ["CorrelationId"] = filter.CorrelationId?.ToString(),
            ["From"] = filter.From?.ToString("yyyy-MM-dd"),
            ["To"] = filter.To?.ToString("yyyy-MM-dd")
        };

        return d.Where(kv => !string.IsNullOrEmpty(kv.Value))
            .ToDictionary(kv => kv.Key, kv => kv.Value);
    }
}
