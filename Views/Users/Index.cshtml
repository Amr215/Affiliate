@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityUser>
@{
    ViewData["Title"] = "المستخدمون";
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">المستخدمون</h1>
        <p class="text-muted mb-0">إدارة حسابات المسؤولين. لا يوجد تسجيل عام — أنت فقط من ينشئ الحسابات.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> إضافة مستخدم
    </a>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>البريد الإلكتروني</th>
                    <th>الدور</th>
                    <th>الحالة</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td class="ltr">@user.Email</td>
                    <td><span class="badge text-bg-primary">Admin</span></td>
                    <td>
                        @if (user.LockoutEnd.HasValue && user.LockoutEnd > DateTimeOffset.UtcNow)
                        {
                            <span class="text-danger">مقفل</span>
                        }
                        else
                        {
                            <span class="text-success">نشط</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
