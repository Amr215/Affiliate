@model CreateUserViewModel
@{
    ViewData["Title"] = "إضافة مستخدم";
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">إضافة مستخدم</h1>
        <p class="text-muted mb-0">سيتم إنشاء الحساب بدور Admin تلقائياً.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control ltr" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control ltr" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
                <div class="form-text">8 أحرف على الأقل، مع حرف كبير وصغير ورقم ورمز خاص.</div>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control ltr" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> إنشاء</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
