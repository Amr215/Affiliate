@model NoonBrandUrl
@{
    ViewData["Title"] = "حذف براند نون";
}

<div class="page-toolbar">
    <h1 class="h2">حذف رابط براند نون</h1>
</div>

<div class="alert alert-warning">
    هل أنت متأكد من حذف <strong class="arabic-text">@Model.Name</strong>؟ المنتجات المحفوظة تبقى بدون براند.
</div>

<dl class="row">
    <dt class="col-sm-3">الرابط</dt>
    <dd class="col-sm-9 ltr text-break">@Model.Url</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">حذف</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">إلغاء</a>
</form>
