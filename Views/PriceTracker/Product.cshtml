@model PriceTrackerProductViewModel
@using System.Globalization
@using System.Text.Json
@using Affiliate.Options
@using Affiliate.Services
@inject Microsoft.Extensions.Options.IOptions<TelegramOptions> TelegramOptions
@{
    Layout = "_PublicLayout";
    var ar = Model.IsArabic;
    ViewData["Lang"] = Model.Lang;
    var brand = ar ? "عروض السندباد" : "El Sindbad Deals";
    var name = Model.DisplayName(ar);
    var currency = Model.Currency ?? "EGP";
    const string seoCurrency = "EGP";
    var priceCulture = CultureInfo.InvariantCulture;
    var currentText = Model.Stats.CurrentPrice?.ToString("#,0.##", priceCulture) ?? "—";
    var lowText = Model.Stats.LowestPrice?.ToString("#,0.##", priceCulture) ?? "—";
    var highText = Model.Stats.HighestPrice?.ToString("#,0.##", priceCulture) ?? "—";

    var title = ar
        ? $"{name} | تتبع السعر | {brand}"
        : $"{name} | Price Tracker | {brand}";
    ViewData["Title"] = title;

    var lastDetectedText = Model.LastDetectedAt?.ToString("yyyy-MM-dd", priceCulture);
    var priceLabel = Model.ShowLastDetected
        ? (ar ? "آخر سعر مُسجَّل" : "Last detected")
        : (ar ? "السعر الحالي" : "Current");

    var badgeText = Model.ShowLastDetected
        ? (lastDetectedText != null
            ? (ar ? $"آخر سعر مُكتشف كان في {lastDetectedText}." : $"Last detected price was on {lastDetectedText}.")
            : null)
        : Model.Stats.IsLowestEver
            ? (ar ? "هذا أقل سعر مسجّل للمنتج." : "This is the lowest recorded price.")
            : Model.Stats.IsLowestIn30DaysOrMore
                ? (ar ? $"السعر الحالي هو الأقل منذ {Model.Stats.LowestPriceDays} يومًا." : $"Current price is the lowest in {Model.Stats.LowestPriceDays} days.")
                : null;

    var productDescription = Model.DisplayDescription(ar);
    var priceSummary = Model.ShowLastDetected
        ? (ar
            ? $"تتبع سعر {name}. آخر سعر مُسجَّل {currentText} {currency}" + (lastDetectedText != null ? $" في {lastDetectedText}." : ".") + $" أقل سعر {lowText} وأعلى سعر {highText}."
            : $"Track the price of {name}. Last detected {currentText} {currency}" + (lastDetectedText != null ? $" on {lastDetectedText}." : ".") + $" Lowest {lowText}, highest {highText}.")
        : (ar
            ? $"تتبع سعر {name}. السعر الحالي {currentText} {currency}. أقل سعر {lowText} وأعلى سعر {highText}."
            : $"Track the price of {name}. Current {currentText} {currency}. Lowest {lowText}, highest {highText}.");
    if (badgeText != null && !Model.ShowLastDetected)
        priceSummary = $"{priceSummary} {badgeText}";

    var hasReviews = Model.Rating is > 0 && Model.ReviewsCount is > 0;
    var ratingValue = hasReviews ? Model.Rating!.Value : 0;
    var ratingText = hasReviews ? ratingValue.ToString("0.0", priceCulture) : null;
    var reviewsCountText = hasReviews ? Model.ReviewsCount!.Value.ToString("#,0", priceCulture) : null;
    if (hasReviews)
    {
        var reviewBlurb = ar
            ? $"تقييم {ratingText} من 5 ({reviewsCountText} مراجعة)."
            : $"Rated {ratingText} out of 5 ({reviewsCountText} reviews).";
        priceSummary = $"{priceSummary} {reviewBlurb}";
    }

    string TruncateMeta(string text, int max = 320)
    {
        if (string.IsNullOrWhiteSpace(text) || text.Length <= max)
            return text;
        var cut = text[..max].TrimEnd();
        var space = cut.LastIndexOf(' ');
        if (space > max * 3 / 4)
            cut = cut[..space];
        return cut.TrimEnd(',', '.', ';', '،') + "…";
    }

    var description = !string.IsNullOrWhiteSpace(productDescription)
        ? TruncateMeta($"{productDescription} {priceSummary}")
        : priceSummary;
    ViewData["MetaDescription"] = description;
    ViewData["MetaKeywords"] = ar
        ? $"{name}, تتبع سعر, أقل سعر, {brand}"
        : $"{name}, price tracker, lowest price, {brand}";

    var site = (ViewData["SiteBaseUrl"] as string
        ?? TelegramOptions.Value.PublishLinkBaseUrl
        ?? "https://el-sindbad.com").Trim().TrimEnd('/');
    var path = $"/tracker/{Model.Asin}/{Uri.EscapeDataString(Model.Slug)}";
    var canonical = $"{site}{path}?lang={Model.Lang}";
    var hreflangAr = $"{site}{path}?lang=ar";
    var hreflangEn = $"{site}{path}?lang=en";
    var ogImage = string.IsNullOrWhiteSpace(Model.ImageUrl) ? $"{site}/images/sinbad-logo.png" : Model.ImageUrl;

    var chartDataJson = JsonSerializer.Serialize(new
    {
        labels = Model.Stats.ChartPoints.Select(p => p.Label).ToList(),
        prices = Model.Stats.ChartPoints.Select(p => p.Price).ToList(),
        currency,
        seriesLabel = ar ? "السعر" : "Price"
    });

    var jsonLd = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Product",
        ["name"] = name,
        ["description"] = string.IsNullOrWhiteSpace(productDescription) ? description : productDescription,
        ["sku"] = Model.Asin,
        ["image"] = string.IsNullOrWhiteSpace(Model.ImageUrl) ? null : Model.ImageUrl,
        ["url"] = canonical,
        ["brand"] = new Dictionary<string, string> { ["@type"] = "Brand", ["name"] = brand },
        ["offers"] = new Dictionary<string, object?>
        {
            ["@type"] = "Offer",
            ["url"] = canonical,
            ["priceCurrency"] = seoCurrency,
            ["price"] = Model.Stats.CurrentPrice,
            ["availability"] = "https://schema.org/InStock"
        }
    };
    if (hasReviews)
    {
        var schemaRating = Math.Round(ratingValue, 1);
        jsonLd["aggregateRating"] = new Dictionary<string, object?>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = schemaRating,
            ["reviewCount"] = Model.ReviewsCount,
            ["bestRating"] = 5,
            ["worstRating"] = 1
        };
        jsonLd["review"] = new object[]
        {
            new Dictionary<string, object?>
            {
                ["@type"] = "Review",
                ["name"] = name,
                ["reviewBody"] = ar
                    ? $"متوسط تقييم العملاء {ratingText} من 5 بناءً على {reviewsCountText} مراجعة على أمازون."
                    : $"Average customer rating of {ratingText} out of 5 based on {reviewsCountText} Amazon customer reviews.",
                ["reviewRating"] = new Dictionary<string, object?>
                {
                    ["@type"] = "Rating",
                    ["ratingValue"] = schemaRating,
                    ["bestRating"] = 5,
                    ["worstRating"] = 1
                },
                ["author"] = new Dictionary<string, string>
                {
                    ["@type"] = "Organization",
                    ["name"] = "Amazon"
                }
            }
        };
    }
    var jsonLdText = JsonSerializer.Serialize(jsonLd, new JsonSerializerOptions
    {
        DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull,
        Encoder = System.Text.Encodings.Web.JavaScriptEncoder.UnsafeRelaxedJsonEscaping
    });

    var switchLang = ar ? "en" : "ar";
    var switchLabel = ar ? "EN" : "ع";
    var switchTitle = ar ? "English" : "العربية";
}

@section Head {
    <link rel="canonical" href="@canonical" />
    <link rel="alternate" hreflang="ar" href="@hreflangAr" />
    <link rel="alternate" hreflang="en" href="@hreflangEn" />
    <link rel="alternate" hreflang="x-default" href="@hreflangAr" />
    <meta property="og:type" content="product" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:locale" content="@(ar ? "ar_EG" : "en_US")" />
    <meta property="product:price:amount" content="@(Model.Stats.CurrentPrice?.ToString(priceCulture))" />
    <meta property="product:price:currency" content="@seoCurrency" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />
    <script type="application/ld+json">@Html.Raw(jsonLdText)</script>
}

<header class="pub-header">
    <a class="pub-logo" asp-controller="Home" asp-action="Index" asp-route-lang="@Model.Lang" aria-label="@brand">
        <img src="~/images/sinbad-logo.svg" alt="@brand" width="40" height="40" asp-append-version="true" />
    </a>
    <a class="pub-page-back" asp-controller="Home" asp-action="Index" asp-route-lang="@Model.Lang">
        @(ar ? "العروض" : "Deals")
    </a>
    <button type="button" class="theme-toggle" id="theme-toggle"
            title="@(ar ? "الوضع الليلي" : "Night mode")"
            aria-label="@(ar ? "تبديل الوضع الليلي" : "Toggle night mode")"
            data-label-day="@(ar ? "الوضع النهاري" : "Day mode")"
            data-label-night="@(ar ? "الوضع الليلي" : "Night mode")">
        <span class="theme-toggle-icon icon-moon" aria-hidden="true">☾</span>
        <span class="theme-toggle-icon icon-sun" aria-hidden="true">☀</span>
    </button>
    <a class="lang-toggle" asp-controller="PriceTracker" asp-action="Product"
       asp-route-asin="@Model.Asin" asp-route-slug="@Model.Slug" asp-route-lang="@switchLang"
       title="@switchTitle" aria-label="@switchTitle">
        <span class="lang-toggle-icon" aria-hidden="true">🌐</span>
        <span class="lang-toggle-code">@switchLabel</span>
    </a>
</header>

<nav class="tracker-breadcrumb" aria-label="@(ar ? "مسار التنقل" : "Breadcrumb")">
    <a asp-controller="Home" asp-action="Index" asp-route-lang="@Model.Lang">@(ar ? "العروض" : "Deals")</a>
    <span class="tracker-breadcrumb-sep" aria-hidden="true">/</span>
    <span class="tracker-breadcrumb-current" dir="@(ar ? "rtl" : "ltr")">@name</span>
</nav>

<article class="tracker-product">
    <div class="tracker-product-hero">
        <div class="tracker-product-media">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@name" width="400" height="400" loading="eager" decoding="async" />
            }
            else
            {
                <span class="deal-noimg">@(ar ? "بدون صورة" : "No image")</span>
            }
        </div>
        <div class="tracker-product-main">
            <h1 dir="@(ar ? "rtl" : "ltr")">@name</h1>

            @if (hasReviews)
            {
                var fullStars = (int)Math.Floor(ratingValue);
                var halfStar = ratingValue - fullStars >= 0.25 && ratingValue - fullStars < 0.75;
                var extraFull = ratingValue - fullStars >= 0.75 ? 1 : 0;
                fullStars = Math.Clamp(fullStars + extraFull, 0, 5);
                var emptyStars = Math.Clamp(5 - fullStars - (halfStar ? 1 : 0), 0, 5);
                <p class="tracker-rating" dir="@(ar ? "rtl" : "ltr")"
                   aria-label="@(ar ? $"تقييم {ratingText} من 5، {reviewsCountText} مراجعة" : $"Rated {ratingText} out of 5, {reviewsCountText} reviews")">
                    <span class="tracker-rating-stars" aria-hidden="true">
                        @for (var s = 0; s < fullStars; s++) { <span class="tracker-star is-full">★</span> }
                        @if (halfStar) { <span class="tracker-star is-half">★</span> }
                        @for (var s = 0; s < emptyStars; s++) { <span class="tracker-star is-empty">★</span> }
                    </span>
                    <span class="tracker-rating-value"><span class="ltr">@ratingText</span>/5</span>
                    <span class="tracker-rating-count">(@(ar ? $"{reviewsCountText} مراجعة" : $"{reviewsCountText} reviews"))</span>
                </p>
            }

            @if (Model.ShowLastDetected && lastDetectedText != null)
            {
                <p class="tracker-flag is-gone">
                    @(ar ? $"آخر سعر مُكتشف كان في {lastDetectedText}" : $"Last detected price was on {lastDetectedText}")
                </p>
            }
            else if (Model.Stats.IsLowestEver)
            {
                <p class="tracker-flag is-best">@(ar ? "أقل سعر على الإطلاق" : "Lowest price ever")</p>
            }
            else if (Model.Stats.IsLowestIn30DaysOrMore)
            {
                <p class="tracker-flag is-good">@(ar ? $"أقل سعر منذ {Model.Stats.LowestPriceDays} يومًا" : $"Lowest in {Model.Stats.LowestPriceDays} days")</p>
            }

            <dl class="tracker-stats">
                <div>
                    <dt>@priceLabel</dt>
                    <dd><span class="ltr">@currentText</span> @currency</dd>
                </div>
                <div>
                    <dt>@(ar ? "أقل سعر" : "Lowest")</dt>
                    <dd><span class="ltr">@lowText</span> @currency</dd>
                </div>
                <div>
                    <dt>@(ar ? "أعلى سعر" : "Highest")</dt>
                    <dd><span class="ltr">@highText</span> @currency</dd>
                </div>
                <div>
                    <dt>@(ar ? "المتوسط" : "Average")</dt>
                    <dd><span class="ltr">@(Model.Stats.AveragePrice?.ToString("#,0.##", priceCulture) ?? "—")</span> @currency</dd>
                </div>
            </dl>

            <a class="tracker-buy" href="@Model.BuyUrl" target="_blank" rel="nofollow noopener sponsored">
                @(ar ? "شراء من أمازون" : "Buy on Amazon")
            </a>
        </div>
    </div>

    <section class="tracker-chart-block" aria-labelledby="tracker-chart-title">
        <h2 id="tracker-chart-title">@(ar ? "تغيّر السعر" : "Price history")</h2>
        @if (Model.Stats.ChartPoints.Count < 2)
        {
            <p class="tracker-chart-empty">@(ar ? "لا توجد نقاط كافية لرسم المخطط بعد." : "Not enough history points to draw a chart yet.")</p>
        }
        else
        {
            <div class="tracker-chart-wrap"
                 data-error-load="@(ar ? "تعذر تحميل المخطط." : "Could not load the chart.")">
                <canvas id="price-chart" aria-label="@(ar ? "مخطط السعر" : "Price chart")"></canvas>
            </div>
            <script type="application/json" id="price-chart-data">@Html.Raw(chartDataJson)</script>
            <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
            <script src="~/js/price-tracker-chart.js" asp-append-version="true"></script>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(productDescription))
    {
        var displayDescription = TrackerDescriptionFormat.ForDisplay(productDescription, ar);
        var descParts = TrackerDescriptionFormat.SplitForList(productDescription)
            .Select(p => TrackerDescriptionFormat.ForDisplay(p, ar))
            .ToList();
        var useDescList = descParts.Count >= 2;
        <section class="tracker-desc-block" aria-labelledby="tracker-desc-title">
            <div class="tracker-desc-card">
                <header class="tracker-desc-head">
                    <h2 id="tracker-desc-title">@(ar ? "وصف المنتج" : "Product description")</h2>
                </header>
                <div class="tracker-desc-body" dir="@(ar ? "rtl" : "ltr")">
                    @if (useDescList)
                    {
                        <ul class="tracker-desc-list">
                            @foreach (var part in descParts)
                            {
                                <li>@part</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="tracker-product-desc">@displayDescription</p>
                    }
                </div>
            </div>
        </section>
    }

    @if (Model.RelatedProducts.Count > 0)
    {
        var relatedTitle = ar ? "منتجات مرتبطة" : "Related products";
        <section class="tracker-related-block" aria-labelledby="tracker-related-title">
            <h2 id="tracker-related-title">@relatedTitle</h2>
            <ul class="deal-grid tracker-related-grid" role="list">
                @for (var i = 0; i < Model.RelatedProducts.Count; i++)
                {
                    var d = Model.RelatedProducts[i];
                    var cardTitle = d.DisplayName(ar);
                    <li class="deal" style="--i:@i">
                        <a class="deal-link" href="@d.Url">
                            <div class="deal-media">
                                @if (!string.IsNullOrEmpty(d.ImageUrl))
                                {
                                    <img src="@d.ImageUrl" alt="@cardTitle" width="300" height="300" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <span class="deal-noimg" aria-hidden="true">@(ar ? "بدون صورة" : "No image")</span>
                                }
                                @if (d.IsAtLowestPrice)
                                {
                                    <span class="tracker-badge">@(ar ? "عند أقل سعر" : "At lowest")</span>
                                }
                                else if (d.LowestPriceDays >= 30)
                                {
                                    <span class="tracker-badge">@(ar ? $"أقل سعر منذ {d.LowestPriceDays} يوم" : $"Lowest in {d.LowestPriceDays} days")</span>
                                }
                            </div>
                            <div class="deal-body">
                                <h3 class="deal-name" dir="@(ar ? "rtl" : "ltr")">@cardTitle</h3>
                                <p class="deal-price">
                                    <span class="deal-currency">@(d.Currency ?? currency)</span>
                                    <span class="deal-amount">@d.Price.ToString("#,0.##", priceCulture)</span>
                                </p>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </section>
    }
</article>
