@model ScraperSearch
@{
    ViewData["Title"] = "حذف عملية بحث";
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">حذف عملية بحث</h1>
        <p class="lead mb-0">هل أنت متأكد من حذف <strong class="arabic-text">@Model.Name</strong>؟</p>
    </div>
</div>

<div class="card border-danger-subtle">
    <div class="card-body">
        <dl class="row detail-grid mb-4">
            <dt class="col-sm-3">الاستعلام</dt>
            <dd class="col-sm-9"><code class="ltr">@Model.Query</code></dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            @Html.AntiForgeryToken()
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> حذف</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>
