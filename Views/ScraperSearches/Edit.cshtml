@model ScraperSearch
@{
    ViewData["Title"] = "تعديل عملية بحث";
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">تعديل عملية بحث</h1>
        <p class="text-muted mb-0 arabic-text">@Model.Name</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_FormFields" model="Model" />
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> حفظ</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
