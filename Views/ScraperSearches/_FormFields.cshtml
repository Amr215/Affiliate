@model ScraperSearch

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label">الاسم</label>
        <input asp-for="Name" class="form-control arabic-text" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Query" class="form-label">الاستعلام</label>
        <input asp-for="Query" class="form-control ltr" placeholder="e.g. book" />
        <span asp-validation-for="Query" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <label asp-for="Domain" class="form-label">النطاق</label>
        <input asp-for="Domain" class="form-control ltr" placeholder="eg" />
        <span asp-validation-for="Domain" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Locale" class="form-label">اللغة المحلية</label>
        <input asp-for="Locale" class="form-control ltr" placeholder="ar-EG" />
        <span asp-validation-for="Locale" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Source" class="form-label">المصدر</label>
        <input asp-for="Source" class="form-control ltr" />
        <span asp-validation-for="Source" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-4">
        <label asp-for="StartPage" class="form-label">صفحة البداية</label>
        <input asp-for="StartPage" class="form-control ltr" type="number" min="1" />
        <span asp-validation-for="StartPage" class="text-danger"></span>
        <div class="form-text">الصفحات التالية تتبع <code class="ltr">last_visible_page</code> من Oxylabs.</div>
    </div>
    <div class="col-md-4">
        <label asp-for="IntervalSeconds" class="form-label">الفاصل (ثانية)</label>
        <input asp-for="IntervalSeconds" class="form-control ltr" type="number" min="60" />
        <span asp-validation-for="IntervalSeconds" class="text-danger"></span>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <div class="form-check mb-2">
            <input asp-for="Parse" class="form-check-input" />
            <label asp-for="Parse" class="form-check-label">تحليل النتائج (Parse)</label>
        </div>
    </div>
</div>

<hr class="my-4" />
<h2 class="h5 mb-3">سياق Oxylabs</h2>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="SortBy" class="form-label">الترتيب</label>
        <input asp-for="SortBy" class="form-control ltr" placeholder="price_low_to_high" />
        <span asp-validation-for="SortBy" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="GeoLocation" class="form-label">الموقع الجغرافي</label>
        <input asp-for="GeoLocation" class="form-control arabic-text" placeholder="القاهرة" />
        <span asp-validation-for="GeoLocation" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Currency" class="form-label">العملة</label>
        <input asp-for="Currency" class="form-control ltr" placeholder="EGP" />
        <span asp-validation-for="Currency" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-3">
        <label asp-for="MinPrice" class="form-label">أدنى سعر</label>
        <input asp-for="MinPrice" class="form-control ltr" type="number" step="1" min="0" />
        <span asp-validation-for="MinPrice" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="MaxPrice" class="form-label">أعلى سعر</label>
        <input asp-for="MaxPrice" class="form-control ltr" type="number" step="1" min="0" />
        <span asp-validation-for="MaxPrice" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="CategoryId" class="form-label">معرّف الفئة</label>
        <input asp-for="CategoryId" class="form-control ltr" />
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="MerchantId" class="form-label">معرّف التاجر</label>
        <input asp-for="MerchantId" class="form-control ltr" />
        <span asp-validation-for="MerchantId" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mt-1">
    <div class="col-md-8">
        <label asp-for="Refinements" class="form-label">التحسينات</label>
        <input asp-for="Refinements" class="form-control ltr" />
        <span asp-validation-for="Refinements" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CheckEmptyGeo" class="form-label">CheckEmptyGeo</label>
        <select asp-for="CheckEmptyGeo" class="form-select">
            <option value="">(تجاهل)</option>
            <option value="true">true</option>
            <option value="false">false</option>
        </select>
        <span asp-validation-for="CheckEmptyGeo" class="text-danger"></span>
    </div>
</div>

<div class="row g-2 mt-3 mb-2">
    <div class="col-6 col-md-3">
        <div class="form-check">
            <input asp-for="ForceHeaders" class="form-check-input" />
            <label asp-for="ForceHeaders" class="form-check-label">ForceHeaders</label>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="form-check">
            <input asp-for="ForceCookies" class="form-check-input" />
            <label asp-for="ForceCookies" class="form-check-label">ForceCookies</label>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="form-check">
            <input asp-for="HcPolicy" class="form-check-input" />
            <label asp-for="HcPolicy" class="form-check-label">HcPolicy</label>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="form-check">
            <input asp-for="SafeSearch" class="form-check-input" />
            <label asp-for="SafeSearch" class="form-check-label">SafeSearch</label>
        </div>
    </div>
</div>

<div class="form-check mt-3">
    <input asp-for="IsEnabled" class="form-check-input" />
    <label asp-for="IsEnabled" class="form-check-label">مفعّل</label>
</div>
