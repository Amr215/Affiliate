@model OxylabsRequestLog
@{
    ViewData["Title"] = $"سجل Oxylabs #{Model.Id}";
    var isOk = Model.StatusCode == 200;
    var requestedUrl = TryGetRequestedUrl(Model.RequestBody);
}

<div class="page-toolbar">
    <div>
        <h1 class="h2 mb-2">سجل طلب #@Model.Id</h1>
        <div class="d-flex flex-wrap gap-2">
            @if (isOk)
            {
                <span class="badge text-bg-success">@Model.StatusCode @Model.StatusPhrase</span>
            }
            else
            {
                <span class="badge text-bg-danger">@Model.StatusCode @Model.StatusPhrase</span>
            }
            <span class="stat-pill"><i class="bi bi-clock"></i> @Model.RequestedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
        </div>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> العودة للقائمة</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row detail-grid mb-0">
            <dt class="col-sm-3">رابط السكرابر</dt>
            <dd class="col-sm-9">
                @if (Model.ScraperUrl != null)
                {
                    <a asp-controller="ScraperUrls" asp-action="Details" asp-route-id="@Model.ScraperUrlId" class="arabic-text">
                        @Model.ScraperUrl.Name
                    </a>
                    <span class="text-muted ltr">(ID @Model.ScraperUrlId)</span>
                }
                else if (Model.ScraperUrlId == null)
                {
                    <span>ASIN recheck</span>
                }
                else
                {
                    <span class="ltr">ID @Model.ScraperUrlId</span>
                }
            </dd>

            <dt class="col-sm-3">الصفحة</dt>
            <dd class="col-sm-9 num">@Model.Page</dd>

            <dt class="col-sm-3">البورت</dt>
            <dd class="col-sm-9 ltr num">@(Model.Port?.ToString() ?? "—")</dd>

            <dt class="col-sm-3">وقت الطلب (UTC)</dt>
            <dd class="col-sm-9 num">@Model.RequestedAt.ToString("yyyy-MM-dd HH:mm:ss")</dd>

            <dt class="col-sm-3">رمز الحالة</dt>
            <dd class="col-sm-9 num">
                @Model.StatusCode
                @if (!string.IsNullOrEmpty(Model.StatusPhrase))
                {
                    <span class="text-muted">— @Model.StatusPhrase</span>
                }
            </dd>

            @if (!string.IsNullOrEmpty(requestedUrl))
            {
                <dt class="col-sm-3">الرابط المطلوب</dt>
                <dd class="col-sm-9 min-w-0">
                    <div class="requested-url-row">
                        <div class="requested-url-text">
                            <a href="@requestedUrl" target="_blank" rel="noopener" class="ltr" id="requestedUrlText">@requestedUrl</a>
                        </div>
                        <button type="button"
                                class="btn btn-sm btn-outline-secondary copy-to-clipboard flex-shrink-0"
                                data-copy-target="#requestedUrlText"
                                title="نسخ الرابط">
                            <i class="bi bi-clipboard"></i> نسخ
                        </button>
                    </div>
                </dd>
            }
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span><i class="bi bi-send"></i> نص الطلب (Request)</span>
        @if (!string.IsNullOrEmpty(Model.RequestBody))
        {
            <button type="button"
                    class="btn btn-sm btn-outline-secondary copy-to-clipboard"
                    data-copy-target="#requestBodyText"
                    title="نسخ نص الطلب">
                <i class="bi bi-clipboard"></i> نسخ
            </button>
        }
    </div>
    <div class="card-body">
        @if (string.IsNullOrEmpty(Model.RequestBody))
        {
            <p class="text-muted mb-0">لا يوجد</p>
        }
        else
        {
            <pre class="log-body mb-0 ltr"><code id="requestBodyText">@Model.RequestBody</code></pre>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header fw-bold d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span>
            <i class="bi bi-reply"></i> نص الاستجابة (Response)
            @if (isOk)
            {
                <span class="text-muted fw-normal small">— يُحفظ فقط عند الحالة ≠ 200</span>
            }
        </span>
        @if (!string.IsNullOrEmpty(Model.ResponseBody))
        {
            <button type="button"
                    class="btn btn-sm btn-outline-secondary copy-to-clipboard"
                    data-copy-target="#responseBodyText"
                    title="نسخ نص الاستجابة">
                <i class="bi bi-clipboard"></i> نسخ
            </button>
        }
    </div>
    <div class="card-body">
        @if (string.IsNullOrEmpty(Model.ResponseBody))
        {
            <p class="text-muted mb-0">لا يوجد محتوى محفوظ لهذه الاستجابة.</p>
        }
        else
        {
            <pre class="log-body mb-0 ltr"><code id="responseBodyText">@Model.ResponseBody</code></pre>
        }
    </div>
</div>

@functions {
    private static string? TryGetRequestedUrl(string? requestBody)
    {
        if (string.IsNullOrWhiteSpace(requestBody))
            return null;

        const string marker = " GET ";
        var i = requestBody.LastIndexOf(marker, StringComparison.Ordinal);
        if (i >= 0)
        {
            var url = requestBody[(i + marker.Length)..].Trim();
            if (url.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                return url;
        }

        var http = requestBody.IndexOf("http", StringComparison.OrdinalIgnoreCase);
        return http >= 0 ? requestBody[http..].Trim() : null;
    }
}

@section Scripts {
<script>
    document.querySelectorAll('.copy-to-clipboard').forEach(function (btn) {
        btn.addEventListener('click', async function () {
            var target = document.querySelector(btn.getAttribute('data-copy-target'));
            if (!target) return;

            var text = target.textContent || '';
            var label = btn.innerHTML;
            try {
                await navigator.clipboard.writeText(text);
                btn.innerHTML = '<i class="bi bi-check2"></i> تم النسخ';
                btn.classList.add('btn-success');
                btn.classList.remove('btn-outline-secondary');
                setTimeout(function () {
                    btn.innerHTML = label;
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-secondary');
                }, 1500);
            } catch (e) {
                btn.innerHTML = '<i class="bi bi-x-lg"></i> فشل';
                setTimeout(function () { btn.innerHTML = label; }, 1500);
            }
        });
    });
</script>
}
