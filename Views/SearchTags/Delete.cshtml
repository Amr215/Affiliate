@model Affiliate.Controllers.SearchTagListItem
@{
    ViewData["Title"] = "حذف الوسم";
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">حذف الوسم</h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <p>هل تريد حذف الوسم <strong class="arabic-text">@Model.NameAr</strong> / <span class="ltr">@Model.NameEn</span>؟</p>
        @if (Model.ScraperUrlCount > 0)
        {
            <p class="text-muted mb-0">مرتبط بـ @Model.ScraperUrlCount رابط سكرابر — سيُزال الوسم منها (SetNull).</p>
        }
    </div>
    <div class="card-footer d-flex gap-2">
        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">حذف</button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</div>
