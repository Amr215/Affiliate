@model IReadOnlyList<Affiliate.Controllers.SearchTagListItem>
@{
    ViewData["Title"] = "وسوم البحث";
}

<div class="page-toolbar">
    <div>
        <h1 class="h2">وسوم البحث</h1>
        <p class="text-muted mb-0">تُستخدم لتصفية المنتجات في الصفحة العامة حسب رابط السكرابر.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> وسم جديد</a>
    </div>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<div class="table-panel">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>العربي</th>
                    <th>English</th>
                    <th>روابط السكرابر</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td class="arabic-text">@t.NameAr</td>
                    <td class="ltr">@t.NameEn</td>
                    <td class="num">@t.ScraperUrlCount</td>
                    <td class="text-nowrap text-end">
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">تعديل</a>
                        <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">حذف</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-tags"></i>
        <p class="mb-0">لا توجد وسوم بعد. أنشئ وسماً ثم اربطه بروابط السكرابر.</p>
    </div>
}
